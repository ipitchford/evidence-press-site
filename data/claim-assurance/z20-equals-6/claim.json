  "statement": {
    "short": "z(20) = 6",
    "naturalLanguage": "For every finite simple graph G on 20 vertices, the cochromatic number z(G) is at most 6, and there exists a finite simple graph on 20 vertices whose cochromatic number is 6; equivalently, z(20)=6.",
    "latex": "z(20)=\\max_{|V(G)|=20} z(G)=6",
    "definitions": [
      "For a finite simple graph G, z(G) is the minimum number of parts in a partition of V(G) in which every part induces either a clique or an independent set.",
      "For n >= 1, z(n) is the maximum of z(G) over finite simple graphs G with n vertices."
    ]
  },
  "release": {
    "slug": "z20-equals-6",
