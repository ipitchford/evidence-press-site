  "scope": {
    "resolution": "finite-case",
    "domain": "finite graph theory; cochromatic numbers; fixed finite order n=20",
    "canonicalProblem": {
      "name": "Erdos problem 758 (the n=20 cochromatic-number case)",
      "url": "https://www.erdosproblems.com/758"
    },
    "assumptions": [
      "Graphs are finite, simple and undirected.",
      "The computer-assisted upper bound depends on the mathematical reduction, catalogue generation, graph-to-CNF encoding, exact CNFs, proof objects and checker behavior described separately below."
    ]
