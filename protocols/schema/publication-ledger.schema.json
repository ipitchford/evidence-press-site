{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evidencepress.org/protocols/api/v2/publication-ledger.schema.json",
  "title": "Productivity Protocols publication ledger",
  "description": "A reviewed, immutable description of one release candidate. The ledger pins the exact build source, public index and starter surfaces, protocol identities and statuses, page bytes, machine records, and downloadable archives. It is never updated automatically by the integrity checker.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "ledger_id",
    "ledger_revision",
    "release_status",
    "published_at",
    "site",
    "source",
    "surfaces",
    "starter",
    "protocols",
    "note"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": "2.0" },
    "ledger_id": { "const": "productivity-protocols" },
    "ledger_revision": { "type": "integer", "minimum": 1 },
    "release_status": { "enum": ["candidate", "published"] },
    "published_at": { "type": ["string", "null"], "format": "date-time" },
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_url", "base_path"],
      "properties": {
        "base_url": { "type": "string", "format": "uri" },
        "base_path": { "type": "string", "pattern": "^(|/([^?#]*/)?)$" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "tree", "date", "dirty", "builder"],
      "properties": {
        "commit": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{40}$",
          "description": "Full Git HEAD reported by build-protocols.js. A dirty=true candidate may contain uncommitted inputs beyond this commit; null is reserved for an explicitly non-Git development candidate."
        },
        "tree": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{40}$",
          "description": "Git tree for commit. It does not include uncommitted changes when dirty is true."
        },
        "date": { "type": ["string", "null"], "format": "date-time" },
        "dirty": {
          "type": ["boolean", "null"],
          "description": "Exact builder-reported source state. Production requires false; true is accepted only with explicit --candidate; null means source identity was unavailable."
        },
        "builder": {
          "type": "string",
          "pattern": "^build-protocols@[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
        }
      }
    },
    "surfaces": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "registry", "sitemap"],
      "properties": {
        "index": { "$ref": "#/$defs/file" },
        "registry": { "$ref": "#/$defs/file" },
        "sitemap": { "$ref": "#/$defs/file" }
      }
    },
    "starter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["software_version", "page", "archive"],
      "properties": {
        "software_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
        },
        "page": { "$ref": "#/$defs/file" },
        "archive": { "$ref": "#/$defs/file" }
      }
    },
    "protocols": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/protocol" }
    },
    "note": { "type": "string", "minLength": 20 }
  },
  "$defs": {
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "assurance_status",
        "productivity_evidence",
        "page",
        "record",
        "archive"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "assurance_status": {
          "enum": [
            "DRAFT",
            "STRUCTURE_VALIDATED",
            "EXAMPLE_CONFORMANCE_VALIDATED",
            "TASKSET_PASSED",
            "CROSS_MODEL_REPRODUCED",
            "SECURITY_REVIEWED",
            "FIELD_READY",
            "DEPRECATED"
          ]
        },
        "productivity_evidence": {
          "enum": [
            "NO_IMPACT_EVIDENCE",
            "BENCHMARK_SIGNAL",
            "CONTROLLED_USER_SIGNAL",
            "FIELD_SIGNAL",
            "CAUSAL_EFFECT_SUPPORTED",
            "NO_CLEAR_GAIN",
            "HARM_OR_REGRESSION_FOUND"
          ]
        },
        "page": { "$ref": "#/$defs/file" },
        "record": { "$ref": "#/$defs/file" },
        "archive": { "$ref": "#/$defs/file" }
      }
    }
  }
}
