{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evidencepress.org/api/schemas/implementation-status.schema.json",
  "title": "Evidence Press implementation status",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "recordType", "updated", "costBoundary", "claimCeiling", "initiatives", "sourceRefs"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "recordType": {"const": "implementation-status"},
    "updated": {"type": "string", "format": "date"},
    "costBoundary": {"type": "string", "minLength": 1},
    "claimCeiling": {"type": "string", "minLength": 1},
    "initiatives": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "state", "implemented", "notImplemented", "cashCost", "operation", "sourceRefs"],
        "properties": {
          "id": {"type": "string"},
          "state": {"enum": ["pilot", "partial", "deferred"]},
          "implemented": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "notImplemented": {"type": "array", "items": {"type": "string"}},
          "cashCost": {"const": "zero-required"},
          "operation": {"enum": ["static-build", "local-only", "not-operational"]},
          "sourceRefs": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    },
    "sourceRefs": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
