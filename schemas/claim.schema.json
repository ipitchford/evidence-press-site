{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evidencepress.org/api/schemas/claim.schema.json",
  "title": "Evidence Press claim record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "recordType", "claimId", "claimKey", "claimVersion",
    "statementFingerprint", "statement", "release", "scope", "nonClaims",
    "obligations", "statuses", "dependencies", "artifacts", "provenance",
    "license", "supersedes", "sourceRefs"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "recordType": { "const": "claim" },
    "claimId": { "type": "string", "pattern": "^ep-claim:sha256:[0-9a-f]{64}$" },
    "claimKey": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "claimVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "statementFingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "statement": { "$ref": "#/$defs/statement" },
    "release": { "$ref": "#/$defs/release" },
    "scope": { "$ref": "#/$defs/scope" },
    "nonClaims": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonClaim" } },
    "obligations": { "type": "array", "minItems": 6, "maxItems": 6, "items": { "$ref": "#/$defs/obligation" } },
    "statuses": { "$ref": "#/$defs/statuses" },
    "dependencies": { "type": "array", "items": { "$ref": "#/$defs/dependency" } },
    "artifacts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/artifact" } },
    "provenance": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "license": { "const": "CC0-1.0" },
    "supersedes": { "type": ["string", "null"] },
    "sourceRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  },
  "$defs": {
    "statement": {
      "type": "object", "additionalProperties": false,
      "required": ["short", "naturalLanguage", "latex", "definitions"],
      "properties": {
        "short": { "type": "string", "minLength": 1 },
        "naturalLanguage": { "type": "string", "minLength": 1 },
        "latex": { "type": "string", "minLength": 1 },
        "definitions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "release": {
      "type": "object", "additionalProperties": false,
      "required": ["slug", "version", "doi", "status", "repository", "sourceCommit", "sourceTag"],
      "properties": {
        "slug": { "type": "string" }, "version": { "type": "string" },
        "doi": { "type": "string" }, "status": { "type": "string" },
        "repository": { "type": "string", "format": "uri" },
        "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "sourceTag": { "type": "string", "minLength": 1 }
      }
    },
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["resolution", "domain", "canonicalProblem", "assumptions"],
      "properties": {
        "resolution": { "enum": ["full-resolution", "partial-result", "conditional", "finite-case", "counterexample", "formalisation"] },
        "domain": { "type": "string", "minLength": 1 },
        "canonicalProblem": { "type": "object", "required": ["name", "url"], "properties": { "name": { "type": "string" }, "url": { "type": "string", "format": "uri" } } },
        "assumptions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "nonClaim": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "statement"],
      "properties": { "id": { "type": "string" }, "statement": { "type": "string", "minLength": 1 } }
    },
    "obligation": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "label", "state", "evidenceRefs", "claimCeiling"],
      "properties": {
        "id": { "enum": ["lower-bound", "reduction", "cnf", "certificate", "checker", "semantic-bridge"] },
        "label": { "type": "string" },
        "state": { "enum": ["proof-text-present", "producer-replayed", "partial", "not-assessed", "failed"] },
        "evidenceRefs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "claimCeiling": { "type": "string", "minLength": 1 }
      }
    },
    "statuses": {
      "type": "object", "additionalProperties": false,
      "required": ["database", "authorClaimed", "formalVerification", "independentReproduction", "humanReview", "novelty", "systemAssessment", "assessedAt"],
      "properties": {
        "database": { "type": "string" }, "authorClaimed": { "type": "string" },
        "formalVerification": { "type": "string" }, "independentReproduction": { "type": "string" },
        "humanReview": { "type": "string" }, "novelty": { "type": "string" },
        "systemAssessment": { "type": "string" }, "assessedAt": { "type": "string", "format": "date" }
      }
    },
    "dependency": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "statement", "status", "sourceRef"],
      "properties": {
        "id": { "type": "string" }, "kind": { "type": "string" },
        "statement": { "type": "string" }, "status": { "type": "string" },
        "sourceRef": { "type": "string" }
      }
    },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "role", "sha256", "url"],
      "properties": {
        "path": { "type": "string" }, "role": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "url": { "type": "string", "format": "uri" }
      }
    }
  }
}
