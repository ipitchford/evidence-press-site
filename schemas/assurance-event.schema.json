{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evidencepress.org/api/schemas/assurance-event.schema.json",
  "title": "Evidence Press append-only assurance event",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "recordType", "eventId", "sequence", "eventDate", "eventType", "claimId", "claimVersion", "taskIds", "receiptIds", "previousEventId", "actor", "summary", "evidenceRefs", "license"],
  "properties": {
    "schemaVersion": { "const": "1.0" }, "recordType": { "const": "assurance-event" },
    "eventId": { "type": "string", "pattern": "^ep-event:[a-z0-9-]+:[0-9]{4}$" },
    "sequence": { "type": "integer", "minimum": 1 }, "eventDate": { "type": "string", "format": "date" },
    "eventType": { "enum": ["claim-registered", "tasks-published", "receipt-imported", "receipt-added", "claim-corrected", "claim-superseded", "objection-recorded", "retraction-recorded"] },
    "claimId": { "type": "string" }, "claimVersion": { "type": "string" },
    "taskIds": { "type": "array", "items": { "type": "string" } }, "receiptIds": { "type": "array", "items": { "type": "string" } },
    "previousEventId": { "type": ["string", "null"] }, "actor": { "type": "string" },
    "summary": { "type": "string", "minLength": 1 }, "evidenceRefs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "license": { "const": "CC0-1.0" }
  }
}
