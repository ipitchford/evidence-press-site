{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evidencepress.org/api/schemas/assurance-task.schema.json",
  "title": "Evidence Press bounded assurance task",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "recordType", "taskId", "taskKey", "taskVersion", "claimId", "claimVersion", "type", "title", "objective", "obligationIds", "inputs", "acceptanceCriteria", "rejectionCriteria", "dependencies", "replayProfileIds", "budget", "independence", "assuranceEffect", "status", "license"],
  "properties": {
    "schemaVersion": { "const": "1.0" }, "recordType": { "const": "assurance-task" },
    "taskId": { "type": "string", "pattern": "^ep-task:[a-z0-9-]+:[a-z0-9-]+:v[1-9][0-9]*$" },
    "taskKey": { "type": "string" }, "taskVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "claimId": { "type": "string", "pattern": "^ep-claim:sha256:[0-9a-f]{64}$" }, "claimVersion": { "type": "string" },
    "type": { "enum": ["integrity-check", "producer-rerun", "independent-rerun", "independent-reimplementation", "formalisation", "specialist-review"] },
    "title": { "type": "string" }, "objective": { "type": "string" },
    "obligationIds": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "inputs": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["ref", "role"],
        "properties": { "ref": { "type": "string" }, "role": { "type": "string" } }
      }
    },
    "acceptanceCriteria": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "rejectionCriteria": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "dependencies": { "type": "array", "items": { "type": "string" } },
    "replayProfileIds": { "type": "array", "items": { "type": "string" } },
    "budget": {
      "type": "object", "additionalProperties": false,
      "required": ["maxActiveMinutes", "maxWallMinutes", "maxMemoryMiB", "cashCost", "networkPolicy"],
      "properties": {
        "maxActiveMinutes": { "type": "integer", "minimum": 1 },
        "maxWallMinutes": { "type": "integer", "minimum": 1 },
        "maxMemoryMiB": { "type": "integer", "minimum": 1 },
        "cashCost": { "const": "zero-required" },
        "networkPolicy": { "const": "forbidden" }
      }
    },
    "independence": {
      "type": "object",
      "required": ["requiredForPromotion", "disclosureRequired", "qualifyingRelationships", "nonQualifyingRelationships"],
      "properties": {
        "requiredForPromotion": { "type": "boolean" },
        "disclosureRequired": { "const": true },
        "qualifyingRelationships": { "type": "array", "items": { "type": "string" } },
        "nonQualifyingRelationships": { "type": "array", "items": { "type": "string" } }
      }
    },
    "assuranceEffect": {
      "type": "object", "required": ["ifPassed", "cannotEstablish"],
      "properties": {
        "ifPassed": { "type": "string" },
        "cannotEstablish": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    },
    "status": { "enum": ["open", "completed", "blocked", "withdrawn", "superseded"] },
    "license": { "const": "CC0-1.0" }
  }
}
