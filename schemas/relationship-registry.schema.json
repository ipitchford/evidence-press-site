{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evidencepress.org/api/schemas/relationship-registry.schema.json",
  "title": "Evidence Press relationship registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "updated",
    "status",
    "claimCeiling",
    "knowledgeStatuses",
    "predicates",
    "assertedRelations",
    "computedRelations",
    "proposedRelations",
    "proposalPolicy",
    "updatePolicy",
    "changeLog"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "updated": { "type": "string", "format": "date" },
    "status": { "type": "string", "minLength": 1 },
    "claimCeiling": { "type": "string", "minLength": 1 },
    "knowledgeStatuses": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asserted", "computed", "proposed"],
      "properties": {
        "asserted": { "type": "string", "minLength": 1 },
        "computed": { "type": "string", "minLength": 1 },
        "proposed": { "type": "string", "minLength": 1 }
      }
    },
    "predicates": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/predicate" } },
    "assertedRelations": { "type": "array", "items": { "$ref": "#/$defs/directRelation" } },
    "computedRelations": { "type": "array", "items": { "$ref": "#/$defs/directRelation" } },
    "proposedRelations": { "type": "array", "items": { "$ref": "#/$defs/proposedRelation" } },
    "proposalPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiredFields", "reviewStates", "publicationRule"],
      "properties": {
        "requiredFields": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
        "reviewStates": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
        "publicationRule": { "type": "string", "minLength": 1 }
      }
    },
    "updatePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "rules"],
      "properties": {
        "mode": { "type": "string", "minLength": 1 },
        "rules": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "changeLog": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["date", "summary"],
        "properties": {
          "date": { "type": "string", "format": "date" },
          "summary": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "predicate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "inverseLabel", "directed", "meaning", "inferenceLimit"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "label": { "type": "string", "minLength": 1 },
        "inverseLabel": { "type": "string", "minLength": 1 },
        "directed": { "type": "boolean" },
        "meaning": { "type": "string", "minLength": 1 },
        "inferenceLimit": { "type": "string", "minLength": 1 }
      }
    },
    "directRelation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "target", "predicate", "basis", "inferenceLimit", "evidenceRefs"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 },
        "predicate": { "type": "string", "minLength": 1 },
        "basis": { "type": "string", "minLength": 1 },
        "inferenceLimit": { "type": "string", "minLength": 1 },
        "evidenceRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "proposedRelation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "source", "target", "predicate", "basis", "inferenceLimit",
        "evidenceRefs", "proposedAt", "proposedBy", "reviewState"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 },
        "predicate": { "type": "string", "minLength": 1 },
        "basis": { "type": "string", "minLength": 1 },
        "inferenceLimit": { "type": "string", "minLength": 1 },
        "evidenceRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "proposedAt": { "type": "string", "format": "date-time" },
        "proposedBy": { "type": "string", "minLength": 1 },
        "reviewState": { "type": "string", "minLength": 1 }
      }
    }
  }
}
